import asyncio
import pandas as pd
import os
import json
from datetime import datetime
from fake_useragent import UserAgent
from playwright.async_api import async_playwright

# --- CONFIGURAZIONE ---
CATEGORIE = ["frutta-e-verdura"] 
FILE_OUTPUT = "estrazione_carrefour_genova.csv"

class CarrefourGenovaScraper:
    def __init__(self):
        self.results = []
        self.processed_stores = set()
        self.ua = UserAgent()
        self.current_store = "N/D"

    async def handle_cookies(self, page):
        """Accetta i cookie all'avvio."""
        try:
            btn = page.locator("#onetrust-accept-btn-handler")
            if await btn.is_visible(timeout=5000):
                await btn.click()
                print("[✓] Cookie accettati.")
        except: pass

    async def auto_scroll(self, page):
        """Scorre la pagina fino in fondo per caricare i prodotti in Lazy Loading."""
        print("      [*] Caricamento prodotti (scrolling)...")
        last_height = await page.evaluate("document.body.scrollHeight")
        while True:
            await page.mouse.wheel(0, 2000)
            await asyncio.sleep(2)
            new_height = await page.evaluate("document.body.scrollHeight")
            if new_height == last_height:
                break
            last_height = new_height

    async def scrape_products_from_dom(self, page):
        """Estrae i prodotti usando la logica avanzata del secondo script."""
        try:
            # Attesa che appaia almeno un prodotto
            await page.wait_for_selector("article.product.tile", timeout=15000)
        except:
            print(f"      [!] Errore: Nessun prodotto trovato in questa categoria.")
            return

        # Recuperiamo tutti i "tiles" dei prodotti
        items = await page.locator("article.product.tile").all()
        count = 0

        for item in items:
            try:
                # 1. Dati dal JSON embedded (Metodo più affidabile)
                raw_json = await item.get_attribute("data-product-json")
                p_data = json.loads(raw_json) if raw_json else {}

                # 2. Marca e Nome
                brand_loc = item.locator("span.brand")
                brand = await brand_loc.inner_text() if await brand_loc.count() > 0 else "N/D"
                
                name_loc = item.locator("span.tile-description")
                name = await name_loc.inner_text() if await name_loc.count() > 0 else p_data.get('name', 'N/D')

                # 3. Logica Prezzi (Scontati vs Originali)
                # Prezzo Attuale (quello che paghi)
                price_now_loc = item.locator("span.value")
                price_now = await price_now_loc.first.inner_text() if await price_now_loc.count() > 0 else "N/D"

                # Prezzo Originale (se presente, solitamente barrato)
                # Cerchiamo i selettori identificati nel secondo script
                old_price_loc = item.locator(".strike-through, del, .price-standard, .cut-price")
                if await old_price_loc.count() > 0:
                    price_old = await old_price_loc.first.inner_text()
                else:
                    price_old = price_now # Se non c'è sconto, l'originale è l'attuale

                # 4. Sconto e Unità
                discount_loc = item.locator(".discount-badge, .discount-percentage, .promotion-badge")
                discount_val = await discount_loc.first.inner_text() if await discount_loc.count() > 0 else "0%"

                unit_price_loc = item.locator("span.unit-price")
                unit_price = await unit_price_loc.first.inner_text() if await unit_price_loc.count() > 0 else "N/D"

                # 5. Salvataggio
                if name != "N/D":
                    self.results.append({
                        "data_estrazione": datetime.now().strftime("%d/%m/%Y"),
                        "negozio": self.current_store,
                        "brand": brand.strip(),
                        "prodotto": name.strip(),
                        "prezzo_scontato": price_now.strip(),
                        "prezzo_originale": price_old.strip(),
                        "sconto_perc": discount_val.strip(),
                        "prezzo_unita": unit_price.strip(),
                        "id": p_data.get('id') or await item.get_attribute("data-pid")
                    })
                    count += 1
            except Exception as e:
                continue
        
        if count > 0:
            print(f"      [✓] Estratti {count} prodotti.")

    async def open_and_setup_sidebar(self, page):
        """Gestisce la localizzazione su Genova e la scelta del negozio."""
        try:
            await page.get_by_text("Imposta metodo e indirizzo").first.click()
            await asyncio.sleep(2)

            input_box = page.locator("#sidebarAddressAutocomplete").first
            if await input_box.is_visible():
                await input_box.fill("Genova")
                await asyncio.sleep(2)
                await page.locator(".pac-item").filter(has_text="Genova, Italia").first.click()
                
                # Selettore Store
                select_el = page.locator("select#storelist")
                await select_el.wait_for(state="attached", timeout=10000)
                await select_el.select_option(index=1)
                await select_el.dispatch_event("change")
                await page.locator(".btn-submit-store").filter(has_text="OK").click(force=True)
                await asyncio.sleep(2)

            # Selezione Ritiro in Negozio (Pickup)
            pickup_btn = page.locator('button.select-service[data-option-service="pickup_in_store"]')
            await pickup_btn.wait_for(state="visible")
            await pickup_btn.click()
            
            await page.locator("ul.stores-list li.store-card").first.wait_for(state="visible")
            await asyncio.sleep(1)
        except Exception as e:
            print(f"      [!] Errore nel setup sidebar: {e}")

    async def run(self):
        async with async_playwright() as p:
            # Avvio browser (headless=False per monitorare se ci sono blocchi)
            browser = await p.chromium.launch(headless=False)
            context = await browser.new_context(user_agent=self.ua.random)
            page = await context.new_page()

            await page.goto("https://www.carrefour.it/spesa-online/", wait_until="load")
            await self.handle_cookies(page)
            await self.open_and_setup_sidebar(page)

            stores_locator = page.locator("ul.stores-list li.store-card")
            num_stores = await stores_locator.count()
            print(f"[*] Trovati {num_stores} punti di ritiro a Genova.")

            for i in range(num_stores):
                current_cards = await page.locator("ul.stores-list li.store-card").all()
                card = current_cards[i]
                
                info_text = await card.locator("p.store-details").inner_text()
                store_name = info_text.splitlines()[0].strip()
                
                if store_name in self.processed_stores: continue

                print(f"\n>>> NEGOZIO ({i+1}/{num_stores}): {store_name}")
                self.current_store = store_name
                self.processed_stores.add(store_name)

                # Selezione Negozio
                await card.click()
                await asyncio.sleep(3)
                
                # Overlay "Scegli più tardi" per lo slot di consegna
                later_btn = page.locator('button:has-text("Scegli più tardi"), button.btn-secondary.small').first
                try:
                    if await later_btn.is_visible(timeout=5000):
                        await later_btn.click()
                        await asyncio.sleep(2)
                except: pass
                
                for cat in CATEGORIE:
                    print(f"    - Categoria: {cat}")
                    await page.goto(f"https://www.carrefour.it/spesa-online/{cat}/", wait_until="domcontentloaded")
                    
                    # Caricamento dinamico
                    await self.auto_scroll(page)
                    
                    # Scraping con logica avanzata
                    await self.scrape_products_from_dom(page)
                
                self.save_data()

                # Torna alla selezione negozio per il prossimo giro
                await page.goto("https://www.carrefour.it/spesa-online/")
                await asyncio.sleep(2)
                await self.open_and_setup_sidebar(page)

            await browser.close()

    def save_data(self):
        if self.results:
            df = pd.DataFrame(self.results).drop_duplicates(subset=['id', 'negozio'])
            path = os.path.join(os.getcwd(), FILE_OUTPUT)
            # Salvataggio ottimizzato: utf-8-sig è leggibile direttamente da Excel
            df.to_csv(path, index=False, encoding='utf-8-sig', sep=';')
            print(f"    [OK] CSV aggiornato: {path} (Totale: {len(df)} prodotti)")

if __name__ == "__main__":
    scraper = CarrefourGenovaScraper()
    asyncio.run(scraper.run())
